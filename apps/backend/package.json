{
  "name": "@revora/backend",
  "version": "1.0.0",
  "main": "dist/server.js",
  "scripts": {
    "dev": "NODE_OPTIONS='--experimental-sqlite --no-warnings' tsx watch src/server.ts",
    "worker": "NODE_OPTIONS='--experimental-sqlite --no-warnings' tsx src/worker/index.ts",
    "worker:once": "NODE_OPTIONS='--experimental-sqlite --no-warnings' tsx src/worker/runOnce.ts",
    "seed": "NODE_OPTIONS='--experimental-sqlite --no-warnings' tsx src/db/seed.ts",
    "build": "tsc",
    "start": "node --experimental-sqlite --no-warnings dist/server.js",
    "start:worker": "node --experimental-sqlite --no-warnings dist/worker/index.js"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "@qdrant/js-client-rest": "^1.13.0",
    "@revora/shared": "*",
    "better-sqlite3": "^11.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
